{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "lib": ["es2022", "dom"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "references": [
    { "path": "../api-contracts/tsconfig.lib.json" },
    { "path": "../domain/tsconfig.lib.json" }
  ],
  "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts"]
}
